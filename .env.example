# ══ Database ═════════════════════════════════════════════
# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ══ Who may sign in ══════════════════════════════════════
# Comma-separated email addresses. Firebase proves who someone is; this decides
# whether they may manage the memorial. An address removed here loses access on
# the very next request. If this list is empty, nobody can sign in.
ADMIN_EMAILS="you@example.com"

# Signs the session cookie. Generate with:  npm run secret
AUTH_SECRET="a-long-random-string-of-at-least-32-characters"

# ══ Where the dashboard lives ════════════════════════════
# One simple segment. Change it here any time — while it is anything other than
# /admin, visiting /admin returns a 404.
ADMIN_PATH="/admin"

# ══ Firebase — browser (sign-in) ═════════════════════════
# From Firebase console → Project settings → Your apps → SDK setup.
# These are public by design; Firebase config is not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="abelolaniyifatokunmemorial.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="abelolaniyifatokunmemorial"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="abelolaniyifatokunmemorial.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="974928341217"
NEXT_PUBLIC_FIREBASE_APP_ID="1:974928341217:web:..."

# ══ Firebase — server (token checks + uploads) ═══════════
# Project settings → Service accounts → Generate new private key.
# THIS ONE IS A REAL SECRET. Paste the whole JSON as a single line, into Vercel
# only. Never into a file that gets committed, and never into a chat window.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
FIREBASE_STORAGE_BUCKET="abelolaniyifatokunmemorial.firebasestorage.app"

# ══ Recommended ══════════════════════════════════════════
NEXT_PUBLIC_SITE_URL="https://abelolaniyifatokunmemorial.vercel.app"

# ══ Optional fallback ════════════════════════════════════
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Email notifications (all optional; the site works without them) ─────────
# Notices go to every address in ADMIN_EMAILS. Pick ONE way to send:
#
# A) Zoho Mail (SMTP)  – recommended
# SMTP_HOST=smtp.zoho.com          # use smtp.zoho.eu / smtp.zoho.in if your Zoho account is in the EU / India
# SMTP_PORT=465
# SMTP_USER=notifications@yourdomain.com
# SMTP_PASS=<a Zoho "app password", not your normal password>
# MAIL_FROM="Abel Fatokun Memorial <notifications@yourdomain.com>"
#
# B) Resend (plain HTTPS)
# RESEND_API_KEY=
#
# C) Webhook (e.g. a Base44 function that sends through a connected Gmail)
# MAIL_WEBHOOK_URL=https://...
# MAIL_WEBHOOK_SECRET=<long random string; the receiver checks the X-Memorial-Signature HMAC-SHA256>
#
# NOTIFY_ENABLED=1                 # set to 0 to pause all notification emails
# CRON_SECRET=<long random string> # lets the daily 07:00 UTC digest + retry job run (Vercel adds it automatically)

# ── Spam protection ("I am a person" check, optional, free) ─────────────────
# Create a Cloudflare Turnstile widget, then set BOTH:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Security / addresses ────────────────────────────────────────────────────
# CANONICAL_HOST=www.abelolaniyifatokunmemorial.vip   # every other host redirects here
# CSP_ENFORCE=1                    # switch the content policy from report-only to enforcing (after a clean week)
# DISABLE_CANONICAL_REDIRECT=1     # emergency off-switch for the host redirect
