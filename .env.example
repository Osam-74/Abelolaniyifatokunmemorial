# ══ Database ═════════════════════════════════════════════
# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ══ Who may sign in ══════════════════════════════════════
# Comma-separated email addresses. Firebase proves who someone is; this decides
# whether they may manage the memorial. An address removed here loses access on
# the very next request. If this list is empty, nobody can sign in.
ADMIN_EMAILS="you@example.com"

# Signs the session cookie. Generate with:  npm run secret
AUTH_SECRET="a-long-random-string-of-at-least-32-characters"

# ══ Where the dashboard lives ════════════════════════════
# One simple segment. Change it here any time — while it is anything other than
# /admin, visiting /admin returns a 404.
ADMIN_PATH="/admin"

# ══ Firebase — browser (sign-in) ═════════════════════════
# From Firebase console → Project settings → Your apps → SDK setup.
# These are public by design; Firebase config is not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="abelolaniyifatokunmemorial.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="abelolaniyifatokunmemorial"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="abelolaniyifatokunmemorial.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="974928341217"
NEXT_PUBLIC_FIREBASE_APP_ID="1:974928341217:web:..."

# ══ Firebase — server (token checks + uploads) ═══════════
# Project settings → Service accounts → Generate new private key.
# THIS ONE IS A REAL SECRET. Paste the whole JSON as a single line, into Vercel
# only. Never into a file that gets committed, and never into a chat window.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
FIREBASE_STORAGE_BUCKET="abelolaniyifatokunmemorial.firebasestorage.app"

# ══ Recommended ══════════════════════════════════════════
NEXT_PUBLIC_SITE_URL="https://abelolaniyifatokunmemorial.vercel.app"

# ══ Optional fallback ════════════════════════════════════
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
