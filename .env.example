# ── Required ─────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway…)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin sign-in. Generate both of these with:  npm run hash-password -- "your password"
ADMIN_USERNAME="family"
ADMIN_PASSWORD_HASH="scrypt:...:..."
AUTH_SECRET="a-long-random-string-of-at-least-32-characters"

# ── Recommended ──────────────────────────────────────────
# Your live URL. Enables the sitemap and correct link previews.
NEXT_PUBLIC_SITE_URL="https://abelolaniyifatokun.vercel.app"

# ── Optional ─────────────────────────────────────────────
# Added automatically when you connect a Vercel Blob store.
# Without it, photographs are added by pasting a link instead of uploading.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
