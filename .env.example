# ── Required ─────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway…)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin sign-in. Generate both of these with:  npm run hash-password -- "your password"
ADMIN_USERNAME="family"
ADMIN_PASSWORD_HASH="scrypt:...:..."
AUTH_SECRET="a-long-random-string-of-at-least-32-characters"

# ── The admin address ────────────────────────────────────
# Where the dashboard lives. Change it here at any time — no code changes needed.
# One simple segment, e.g. /family-office or /fatokun-private.
# While this is set to anything other than /admin, visiting /admin returns 404.
ADMIN_PATH="/admin"

# ── Firebase Storage (photograph and audio uploads) ───────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the entire downloaded JSON as a single line.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"abelolaniyifatokunmemorial", ...}'
FIREBASE_STORAGE_BUCKET="abelolaniyifatokunmemorial.firebasestorage.app"

# Instead of the JSON blob you may set these three separately:
# FIREBASE_PROJECT_ID="abelolaniyifatokunmemorial"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@abelolaniyifatokunmemorial.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ── Recommended ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://abelolaniyifatokunmemorial.vercel.app"

# ── Optional fallback ────────────────────────────────────
# Only used if the Firebase variables above are absent.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
